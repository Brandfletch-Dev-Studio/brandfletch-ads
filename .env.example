# ─────────────────────────────────────────────
# Supabase Environment Variables (Vercel + local)
# ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Public URL (safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for frontend — protected by RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend code or VITE_ vars
# It bypasses RLS and should only be used server-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Meta / Facebook — TWO APPS
# ─────────────────────────────────────────────
# Brandfletch uses two separate Meta apps:
#
# App 1: "Brandfletch Login" — Facebook Login product only
#   Used for OAuth flow (connecting Facebook pages)
#
# App 2: "Brandfletch Marketing" — Marketing API + Pages API products
#   Used for ad creation and page access checks
#
# Both apps must be linked to the same Business Manager.

# ── App 1: Login App (developers.facebook.com → Login app → Settings → Basic) ──
META_LOGIN_APP_ID=your-login-app-id
META_LOGIN_APP_SECRET=your-login-app-secret

# ── App 2: Marketing App (developers.facebook.com → Marketing app → Settings → Basic) ──
META_MARKETING_APP_ID=your-marketing-app-id
META_MARKETING_APP_SECRET=your-marketing-app-secret

# ── Shared: Business Manager (business.facebook.com → Settings → Business Info) ──
META_BUSINESS_ID=your-business-id

# ── System User token (Business Settings → Users → System Users → Generate Token) ──
# Must have permissions on the ad account + pages
META_SYSTEM_USER_TOKEN=your-system-user-token

# ── Meta Ad Account ID (Business Settings → Ad Accounts — without act_ prefix) ──
META_AD_ACCOUNT_ID=your-ad-account-id

# ─────────────────────────────────────────────
# API Base (optional — defaults to same origin on Vercel)
# ─────────────────────────────────────────────
# Only set if API is on a different domain
# VITE_API_BASE=https://your-api-domain.com
