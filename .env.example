# ─────────────────────────────────────────────
# Supabase Environment Variables (Vercel + local)
# ─────────────────────────────────────────────
# Get these from: Supabase Dashboard → Project Settings → API

# Public URL (safe for frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for frontend — protected by RLS)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ⚠️ NEVER put SUPABASE_SERVICE_ROLE_KEY in frontend code or VITE_ vars
# It bypasses RLS and should only be used server-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─────────────────────────────────────────────
# Meta / Facebook API Variables (server-side only — Vercel env vars)
# ─────────────────────────────────────────────
# Get these from: Meta for Developers → your App settings

# Your Meta App ID (from App Dashboard)
META_APP_ID=your-meta-app-id

# Your Meta App Secret (from App Dashboard → Settings → Basic)
META_APP_SECRET=your-meta-app-secret

# Brandfletch's Business Manager ID (from Business Settings → Business Info)
META_BUSINESS_ID=your-business-id

# System User access token (from Business Settings → Users → System Users)
# Must have permissions on the ad account + pages
META_SYSTEM_USER_TOKEN=your-system-user-token

# Meta Ad Account ID (from Business Settings → Ad Accounts — without act_ prefix)
META_AD_ACCOUNT_ID=your-ad-account-id

# ─────────────────────────────────────────────
# API Base (optional — defaults to same origin on Vercel)
# ─────────────────────────────────────────────
# Only set if API is on a different domain
# VITE_API_BASE=https://your-api-domain.com
